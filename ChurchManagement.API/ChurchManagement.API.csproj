    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>09da8688-519b-475f-95a4-caa6f5ce3792</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>.</DockerfileContext>
